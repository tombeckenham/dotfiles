{
  "name": "ghsb-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    }
  ],
  "vars": {
    "DEV_PORT": "3000"
  }
  // Set secrets after deploy:
  //   wrangler secret put GHSB_API_TOKEN
  //   wrangler secret put GITHUB_TOKEN   (optional; clone private repos)
}
